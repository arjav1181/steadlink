{
  "name": "steadlink",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @steadlink/web dev",
    "build": "pnpm --filter @steadlink/web build",
    "start": "pnpm --filter @steadlink/web start",
    "lint": "biome check .",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @steadlink/db seed && node --experimental-strip-types scripts/seed-passwords.ts",
    "migrate": "pnpm --filter @steadlink/db migrate",
    "test:access": "pnpm --filter @steadlink/db test && pnpm --filter @steadlink/data test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e-report",
    "worker": "pnpm --filter @steadlink/worker start"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "axe-core": "4.11.0",
    "better-auth": "1.7.11",
    "postgres": "3.4.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
