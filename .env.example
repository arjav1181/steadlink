# ============================================================================
#  GoLink - environment
#
#  Copy this file to .env and fill in the values you have. Nothing here is
#  required for the app to boot in development: with no mail provider and no
#  AI provider, GoLink runs with the local outbox and no assistant.
#
#  Never commit a filled-in .env. It is in .gitignore.
# ============================================================================

# --- Database ---------------------------------------------------------------
# The Postgres instance GoLink stores everything in.
DATABASE_URL=postgres://golink:golink@127.0.0.1:5432/golink

# The role the migrations run as. It needs to be able to create tables, so
# it is usually the superuser. The application does not use it.
# DATABASE_MIGRATION_URL=postgres://postgres:postgres@127.0.0.1:5432/golink

# The database role the application connects as. It must be a member of
# golink_app, so that row level security applies to it.
# DATABASE_APP_ROLE=golink

# The database role the worker connects as. It must be a member of
# golink_worker, which bypasses row level security, because the rollups
# and the sweeps cross organizations.
#
# The two roles are separate on purpose: membership of a role with
# BYPASSRLS is inherited, so a role holding both would bypass every
# policy and the isolation would be theatre.
# DATABASE_WORKER_ROLE=golinkworker

# How many connections the pool holds.
# DATABASE_POOL_MAX=10

# --- Application ------------------------------------------------------------
# The address the app is served from. It goes into the links in emails.
APP_URL=http://localhost:3210

# The base domain new workspaces get a subdomain of. Each workspace gets
# <slug>.<this>, so back-halves never collide between workspaces.
DEFAULT_SHORT_DOMAIN=go.arjav.is-cool.dev

# --- Authentication ---------------------------------------------------------
# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# The address better-auth issues its own URLs against.
BETTER_AUTH_URL=http://localhost:3210

# Turn on email verification. Off by default so a local install is not
# waiting on a mailbox.
# REQUIRE_EMAIL_VERIFICATION=false

# Google sign-in. Create the app in your own Google Cloud project. The scope
# asked for is the narrowest one that still identifies the user: email and
# profile. Nothing else.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Email ------------------------------------------------------------------
# With no SMTP_HOST the app writes messages to the mail_outbox table and
# logs them instead of sending them. That is the local default.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=GoLink <no-reply@example.com>

# --- Jobs ------------------------------------------------------------------
# The worker reads the same database. The schedule lives in
# apps/worker/src/index.ts.
# WORKER_CONCURRENCY=4

# --- AI assistant (optional) ------------------------------------------------
# OpenAI-compatible. Point the base url at Ollama to run it locally:
#   http://localhost:11434/v1
# The provider is chosen per workspace in Settings, so this is only the
# default for a new one.
# AI_PROVIDER=none
# AI_BASE_URL=
# AI_MODEL=

# --- Geo -------------------------------------------------------------------
# The country and city database. It is downloaded into the image, so there
# is nothing to configure here, but the path is worth knowing about.
# GEOIP_DATA_DIR=/data/geoip
